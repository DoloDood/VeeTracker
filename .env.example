# --- Supabase (Auth + Postgres) ---
# From your Supabase project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auto-populated by Vercel when you connect the Supabase database to this
# project (used by lib/db.js for all app data, separately from auth above).
# POSTGRES_URL=

# --- eBay app credentials (Developer Portal -> Application Keys) ---
# Sandbox and Production are SEPARATE keysets - you need both eventually.
EBAY_CLIENT_ID_SANDBOX=
EBAY_CLIENT_SECRET_SANDBOX=
EBAY_CLIENT_ID_PRODUCTION=
EBAY_CLIENT_SECRET_PRODUCTION=

# Developer Portal -> User Tokens -> create a Redirect URL (RuName) for each
# environment, both pointing their Accept URL at:
#   https://YOUR-DOMAIN/api/ebay/auth-callback
EBAY_RUNAME_SANDBOX=
EBAY_RUNAME_PRODUCTION=

# --- Blob storage (Vercel Blob) ---
# Auto-populated by Vercel when you add Blob storage to the project.
# BLOB_READ_WRITE_TOKEN=
